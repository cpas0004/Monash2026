cells:
  - kind: 2
    value: "CREATE TABLE SUBJECT2 (\r

      \    UCode CHAR(5) NOT NULL,\r

      \    UTitle VARCHAR2(20) NOT NULL,\r

      \    UCredit NUMBER(2) NOT NULL,\r

      \    PRIMARY KEY (UCode)\r

      );\r

      \r

      INSERT INTO SUBJECT2 (UCode, UTitle, UCredit) VALUES ('IT001', 'Database',
      5);\r

      INSERT INTO SUBJECT2 (UCode, UTitle, UCredit) VALUES ('IT002', 'Java',
      5);\r

      INSERT INTO SUBJECT2 (UCode, UTitle, UCredit) VALUES ('IT003', 'SAP',
      10);\r

      INSERT INTO SUBJECT2 (UCode, UTitle, UCredit) VALUES ('IT004', 'Network',
      5);\r

      INSERT INTO SUBJECT2 (UCode, UTitle, UCredit) VALUES ('IT005', 'ASP.net',
      5);\r

      \r\n"
    languageId: oracle-sql
  - kind: 2
    value: "Create Table STUDENT2\r

      As Select *\r

      From dtaniar.STUDENT2;"
    languageId: oracle-sql
  - kind: 2
    value: DESCRIBE STUDENT2;
    languageId: oracle-sql
  - kind: 2
    value: SELECT * FROM STUDENT2;
    languageId: oracle-sql
  - kind: 2
    value: "INSERT INTO STUDENT2 (SID, SLName, SFName, SGender, SDOB, SCategory)
      VALUES (10008, 'Miller', 'Larry', 'M', TO_DATE('22-07-1973',
      'DD-MM-YYYY'), 211);\r

      INSERT INTO STUDENT2 (SID, SLName, SFName, SGender, SDOB, SCategory)
      VALUES (10009, 'Smith', 'Leonard', 'M', TO_DATE('26-05-1985',
      'DD-MM-YYYY'), 211);\r

      INSERT INTO STUDENT2 (SID, SLName, SFName, SGender, SDOB, SCategory)
      VALUES (10010, 'Brown', 'Menson', 'M', TO_DATE('12-07-1983',
      'DD-MM-YYYY'), 112);\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "CREATE TABLE OFFERING2\r

      AS SELECT *\r

      FROM dtaniar.OFFERING2;\r

      \r

      CREATE TABLE ENROLLMENT2\r

      AS SELECT *\r

      FROM dtaniar.ENROLLMENT2;"
    languageId: oracle-sql
  - kind: 2
    value: ""
    languageId: oracle-sql
  - kind: 2
    value: "-- How many students enrolled in the Database unit offered in Main
      campus\r

      \r

      SELECT COUNT(*) AS num_stu\r

      FROM ENROLLMENT2 JOIN OFFERING2 ON ENROLLMENT2.OID = OFFERING2.OID\r

      JOIN SUBJECT2 ON OFFERING2.UCode = SUBJECT2.UCode\r

      WHERE SUBJECT2.UTitle = 'Database' AND OFFERING2.OCampus = 'Main';\r

      \r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- What is the total score of students taking the Database unit in Main
      campus?\r

      \r

      SELECT SUM(ENROLLMENT2.Score) AS total_score\r

      FROM ENROLLMENT2 JOIN OFFERING2 ON ENROLLMENT2.OID = OFFERING2.OID\r

      JOIN SUBJECT2 ON OFFERING2.UCode = SUBJECT2.UCode\r

      WHERE SUBJECT2.UTitle = 'Database' AND OFFERING2.OCampus = 'Main';"
    languageId: oracle-sql
  - kind: 2
    value: "-- How many students enrolled in the Java unit offered in Semester 2,
      2009?\r

      \r

      SELECT COUNT(*) AS num_stu\r

      FROM ENROLLMENT2 JOIN OFFERING2 ON ENROLLMENT2.OID = OFFERING2.OID\r

      JOIN SUBJECT2 ON OFFERING2.UCode = SUBJECT2.UCode\r

      WHERE SUBJECT2.UTitle = 'Java' AND OFFERING2.OSem = 2 AND OFFERING2.OYear
      = 2009;\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- What is the total score of students taking the Java unit in Semester
      2, 2009?\r

      \r

      SELECT SUM(ENROLLMENT2.Score) AS total_score\r

      FROM ENROLLMENT2 JOIN OFFERING2 ON ENROLLMENT2.OID = OFFERING2.OID\r

      JOIN SUBJECT2 ON OFFERING2.UCode = SUBJECT2.UCode\r

      WHERE SUBJECT2.UTitle = 'Java' AND OFFERING2.OSem = 2 AND OFFERING2.OYear
      = 2009;"
    languageId: oracle-sql
  - kind: 2
    value: "SELECT COUNT(*) AS num_HD\r

      FROM ENROLLMENT2 JOIN OFFERING2 ON ENROLLMENT2.OID = OFFERING2.OID\r

      JOIN SUBJECT2 ON OFFERING2.UCode = SUBJECT2.UCode\r

      WHERE SUBJECT2.UTitle = 'SAP' AND ENROLLMENT2.Grade = 'HD' AND
      OFFERING2.OSem = 1 AND OFFERING2.OYear = 2009;"
    languageId: oracle-sql
  - kind: 2
    value: "SELECT * FROM ENROLLMENT2 JOIN OFFERING2 ON ENROLLMENT2.OID =
      OFFERING2.OID\r

      WHERE OFFERING2.OSem = 1 AND OFFERING2.OYear = 2009;"
    languageId: oracle-sql
  - kind: 2
    value: CREATE TABLE LocationDIM as SELECT DISTINCT OCampus FROM OFFERING2;
    languageId: oracle-sql
  - kind: 2
    value: "CREATE TABLE SemesterDIM (\r

      \    SemKey VARCHAR2(10) PRIMARY KEY,\r

      \    OYear  NUMBER(4) NOT NULL,\r

      \    OSem   NUMBER(1) NOT NULL\r

      );"
    languageId: oracle-sql
  - kind: 2
    value: "INSERT INTO SemesterDIM (SemKey, OYear, OSem)\r

      SELECT DISTINCT\r

      \    TO_CHAR(OYear) || '-S' || TO_CHAR(OSem),\r

      \    OYear,\r

      \    OSem\r

      FROM OFFERING2;"
    languageId: oracle-sql
  - kind: 2
    value: CREATE TABLE GradeDIM as SELECT DISTINCT Grade FROM ENROLLMENT2;
    languageId: oracle-sql
  - kind: 2
    value: SELECT * FROM GradeDIM;
    languageId: oracle-sql
  - kind: 2
    value: CREATE TABLE UnitDIM as SELECT DISTINCT UCode, UTitle FROM SUBJECT2;
    languageId: oracle-sql
  - kind: 2
    value: "CREATE TABLE ENROLMENTFACT AS\r

      SELECT \r

      \    O.OCampus, \r

      \    TO_CHAR(O.OYear) || '-S' || TO_CHAR(O.OSem) AS SemKey, \r

      \    S.UCode, \r

      \    E.Grade, \r

      \    COUNT(DISTINCT E.SID) AS num_stu, \r

      \    SUM(E.Score) AS total_score \r

      FROM ENROLLMENT2 E, OFFERING2 O, SUBJECT2 S\r

      WHERE E.OID = O.OID AND O.UCode = S.UCode\r

      GROUP BY O.OCampus, TO_CHAR(O.OYear) || '-S' || TO_CHAR(O.OSem), S.UCode,
      E.Grade"
    languageId: oracle-sql
  - kind: 2
    value: SELECT * FROM ENROLMENTFACT;
    languageId: oracle-sql
  - kind: 2
    value: "-- Use the star schema that you have created, display the average score
      of each unit offered in 2009\r

      \r

      SELECT S.UCode, S.UTitle, SUM(EF.total_score)/SUM(EF.num_stu) AS
      avg_score\r

      FROM ENROLMENTFACT EF JOIN UnitDIM S ON EF.UCode = S.Ucode\r

      JOIN SemesterDIM SD on EF.SemKey = SD.SemKey\r

      WHERE SD.OYear = 2009\r

      GROUP BY S.UCode, S.UTitle"
    languageId: oracle-sql
  - kind: 2
    value: "-- Use the star schema that you have created, display the average score
      of each unit offered in main campus.\r

      \r

      SELECT S.UCode, S.UTitle, SUM(EF.total_score)/SUM(EF.num_stu) AS
      avg_score\r

      FROM ENROLMENTFACT EF JOIN UnitDIM S ON EF.UCode = S.Ucode\r

      JOIN LocationDIM LD on EF.OCampus = LD.Ocampus\r

      WHERE LD.OCampus = 'Main'\r

      GROUP BY S.UCode, S.UTitle"
    languageId: oracle-sql
  - kind: 2
    value: "SELECT SUM(EF.total_score)/SUM(EF.num_stu) as avg_score\r

      FROM ENROLMENTFACT EF JOIN UnitDIM UD on EF.UCode = UD.UCode\r

      JOIN GradeDIM GD on EF.Grade = GD.Grade\r

      WHERE UD.UTitle = 'Database' AND GD.Grade = 'N'\r

      GROUP BY UD.UTitle, GD.Grade\r\n"
    languageId: oracle-sql
